# ============================================================================
# Screen Recorder - environment variables
# ----------------------------------------------------------------------------
# Copy to `.env` for local use (`.env` is gitignored; this template is tracked).
# Every variable below is optional unless noted; defaults are in parentheses.
# ============================================================================

# --- Web app (Next.js) ------------------------------------------------------
# Base URL of the convert API used by the browser. Leave EMPTY in almost all
# cases: the browser calls same-origin /api, which Next.js proxies to the local
# API in dev/bare `next start` and nginx proxies in the container.
# Only set this if the API lives on a different origin.
# Baked in at build time (NEXT_PUBLIC_*).
NEXT_PUBLIC_API_URL=

# Where Next.js proxies /api requests when nginx is not in front (default:
# http://127.0.0.1:3001). NOTE: read when the build (or dev server) starts -
# for `next build` + `next start`, set it before building.
API_PROXY_TARGET=http://127.0.0.1:3001

# Basic Auth username the UI pairs with the transcode password field (default: api).
# Must match the username in the server's htpasswd. Baked in at build time.
NEXT_PUBLIC_API_USER=api

# --- API (Express) ----------------------------------------------------------
# Port the Express convert API listens on (default: 3001).
PORT=3001

# Allowed origin for CORS during local development (default: http://localhost:3000).
FRONTEND_URL=http://localhost:3000

# --- Docker container -------------------------------------------------------
# Credentials for the container's nginx Basic Auth on /api.
# At startup the entrypoint runs: htpasswd -Bbc /etc/nginx/.htpasswd "$API_USER" "$API_PASSWORD"
# If API_PASSWORD is unset the container FAILS CLOSED (every /api request 401s).
API_USER=api
API_PASSWORD=change-me

# Optional: mount a pre-built htpasswd file instead of generating one.
# When set (and the file exists), it overrides API_USER/API_PASSWORD.
#API_HTPASSWD_FILE=/run/secrets/api.htpasswd

# --- Outer reverse proxy (Apache vhost, host-level) -------------------------
# Basic Auth is enforced twice: by the Apache vhost in front of the container
# and by the container's nginx. Keep the same user/password in both htpasswd
# stores so the UI's single password field works end to end.
